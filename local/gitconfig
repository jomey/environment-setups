[alias]
  b = branch
  co = checkout
  s = status
[user]
  name = Joachim Meyer
  signingkey = /home/student/.ssh/github_sign.pub
[push]
  default = current
[pull]
  rebase = true
	ff = only
[core]
  excludesfile = ~/.gitignore
  editor = /usr/bin/vim
  autocrlf = input
[branch]
  autosetuprebase = always
[rebase]
  autoSquash = true
  autoStash = true
[fetch]
  prune = true
[gpg]
  format = ssh
[commit]
  gpgsign = true
[init]
	defaultBranch = main
[credential]
	helper = manager
	credentialStore = secretservice
